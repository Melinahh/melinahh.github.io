</span></span><span>    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
</span><span>    :root {
</span><span>      --sable: #EDE0CE;
</span><span>      --sable-dark: #D4C4AE;
</span><span>      --marron: #3D2B1F;
</span><span>      --marron-mid: #6B4C35;
</span><span>      --gold: #D4A017;
</span><span>      --terra: #C17B4A;
</span><span>      --ce3: #7A3442;
</span><span>      --ce3-light: #D9A0A8;
</span><span>    }
</span><span>    html { scroll-behavior: smooth; }
</span><span>    body { font-family: 'Raleway', sans-serif; background-color: var(--sable); color: var(--marron); min-height: 100vh; font-size: 16px; }
</span><span>
</span><span>    nav {
</span><span>      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
</span><span>      background: rgba(212,196,174,0.95); backdrop-filter: blur(10px);
</span><span>      border-bottom: 1px solid rgba(61,43,31,0.1);
</span><span>      padding: 0 3rem; display: flex; align-items: center;
</span><span>      justify-content: space-between; height: 60px;
</span><span>    }
</span><span>    .nav-logo { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--marron); letter-spacing: 0.05em; text-decoration: none; }
</span><span>    .nav-links { display: flex; gap: 2rem; list-style: none; align-items: center; }
</span><span>    .nav-links a { text-decoration: none; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--marron-mid); transition: color 0.2s; }
</span><span>    .nav-links a:hover, .nav-links a.active { color: var(--gold); }
</span><span>    .dropdown { position: relative; }
</span><span>    .dropdown-toggle { cursor: pointer; display: flex; align-items: center; gap: 4px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); user-select: none; }
</span><span>    .dropdown-toggle::after { content: '▾'; font-size: 0.6rem; transition: transform 0.2s; }
</span><span>    .dropdown-toggle.open::after { transform: rotate(180deg); }
</span><span>    .dropdown-menu { display: none; position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); background: #fff; border: 0.5px solid rgba(61,43,31,0.15); border-radius: 8px; padding: 8px 0; min-width: 280px; box-shadow: 0 4px 20px rgba(61,43,31,0.1); z-index: 9999; }
</span><span>    .dropdown-menu.open { display: block; }
</span><span>    .dropdown-menu a { display: flex; align-items: center; gap: 10px; padding: 10px 16px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--marron-mid); text-decoration: none; transition: background 0.15s, color 0.15s; }
</span><span>    .dropdown-menu a:hover { background: rgba(212,160,23,0.08); color: var(--gold); }
</span><span>    .dropdown-menu-num { font-size: 0.65rem; color: var(--gold); font-weight: 700; min-width: 32px; }
</span><span>
</span><span>    /* HEADER */
</span><span>    .page-header { padding: 8rem 4rem 5rem; background: var(--marron); position: relative; overflow: hidden; text-align: center; }
</span><span>    .page-header::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(237,224,206,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(237,224,206,0.04) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
</span><span>    .h-circle-1 { position: absolute; width: 300px; height: 300px; border: 1px solid rgba(122,52,66,0.18); border-radius: 50%; top: -100px; right: -100px; }
</span><span>    .h-circle-2 { position: absolute; width: 180px; height: 180px; border: 1px solid rgba(122,52,66,0.25); border-radius: 50%; top: -40px; right: -40px; }
</span><span>    .h-circle-3 { position: absolute; width: 200px; height: 200px; border: 1px solid rgba(122,52,66,0.18); border-radius: 50%; bottom: -80px; left: -80px; }
</span><span>    .h-diamond { position: absolute; width: 14px; height: 14px; background: rgba(122,52,66,0.4); transform: rotate(45deg); bottom: 2rem; right: 6rem; }
</span><span>    .h-corner-tl { position: absolute; top: 80px; left: 2rem; width: 28px; height: 28px; border-top: 2px solid rgba(122,52,66,0.4); border-left: 2px solid rgba(122,52,66,0.4); }
</span><span>    .h-corner-tr { position: absolute; top: 80px; right: 2rem; width: 28px; height: 28px; border-top: 2px solid rgba(122,52,66,0.4); border-right: 2px solid rgba(122,52,66,0.4); }
</span><span>    .page-header p.tag { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ce3-light); margin-bottom: 0.8rem; position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 10px; }
</span><span>    .page-header p.tag::before, .page-header p.tag::after { content: ''; width: 40px; height: 1px; background: rgba(217,160,168,0.5); }
</span><span>    .page-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 5vw, 3.5rem); color: var(--sable); position: relative; z-index: 1; line-height: 1.2; }
</span><span>    .header-line { width: 60px; height: 3px; background: var(--ce3); margin: 1.5rem auto 0; position: relative; z-index: 1; }
</span><span>
</span><span>    /* DÉCO */
</span><span>    .deco-wrap { position: relative; overflow: hidden; border-radius: 12px; }
</span><span>    .deco-wrap::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(61,43,31,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(61,43,31,0.03) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; z-index: 0; }
</span><span>    .deco-circle { position: absolute; border: 1px solid rgba(122,52,66,0.2); border-radius: 50%; pointer-events: none; z-index: 0; }
</span><span>    .deco-diamond { position: absolute; background: rgba(122,52,66,0.3); transform: rotate(45deg); pointer-events: none; z-index: 0; }
</span><span>    .corner-tl { position: absolute; top: 16px; left: 16px; width: 28px; height: 28px; border-top: 2px solid rgba(122,52,66,0.4); border-left: 2px solid rgba(122,52,66,0.4); pointer-events: none; z-index: 0; }
</span><span>    .corner-br { position: absolute; bottom: 16px; right: 16px; width: 28px; height: 28px; border-bottom: 2px solid rgba(122,52,66,0.4); border-right: 2px solid rgba(122,52,66,0.4); pointer-events: none; z-index: 0; }
</span><span>    .deco-inner { position: relative; z-index: 1; }
</span><span>
</span><span>    .content { max-width: 1400px; margin: 0 auto; padding: 5rem 3rem 6rem; display: flex; flex-direction: column; gap: 3rem; }
</span><span>
</span><span>    .section-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ce3); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 10px; }
</span><span>    .section-label::after { content: ''; flex: 1; height: 1px; background: rgba(122,52,66,0.25); }
</span><span>    .section-title { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--marron); margin-bottom: 2rem; line-height: 1.2; }
</span><span>
</span><span>    .sep { display: flex; align-items: center; gap: 1.5rem; }
</span><span>    .sep-line { flex: 1; height: 1px; background: rgba(61,43,31,0.1); }
</span><span>    .sep-diamond { width: 8px; height: 8px; background: var(--ce3); transform: rotate(45deg); }
</span><span>
</span><span>    /* BLOC PRINCIPAL */
</span><span>    .comp-bloc { display: flex; align-items: center; gap: 2rem; background: var(--marron); border-radius: 14px; padding: 3rem; position: relative; overflow: hidden; }
</span><span>    .comp-bloc::after { content: ''; position: absolute; bottom: -40px; right: -40px; width: 140px; height: 140px; border: 1px solid rgba(122,52,66,0.25); border-radius: 50%; }
</span><span>    .comp-number { width: 70px; height: 70px; background: var(--ce3); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-size</span></code></pre></div></div></div></div></div></div></div><div class="flex justify-start" role="group" aria-label="Message actions"><div class="text-text-300"><div class="text-text-300 flex items-stretch justify-between"><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Copier" data-testid="action-bar-copy" id="base-ui-_r_7jj_"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span class="relative"><span data-cds="Icon" class="transition-all opacity-100 scale-100" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span><span data-