t aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Modifier" data-testid="action-bar-edit" id="base-ui-_r_706_"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span data-cds="Icon" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span></span></button></div><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Copier" data-testid="action-bar-copy" id="base-ui-_r_708_"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span class="relative"><span data-cds="Icon" class="transition-all opacity-100 scale-100" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span><span data-cds="Icon" class="absolute inset-0 transition-all opacity-0 scale-50" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em; display: flex; align-items: center; justify-content: center; flex-shrink: 0; user-select: none; font-size: 20px; font-weight: 433.3;"></span></span></span></button><div class="flex items-center"></div></div></div></div></div></div></div></div></div><div class="[content-visibility:auto] [contain-intrinsic-size:auto_400px] px-2 -mx-2 pb-8 -mb-8 print:[content-visibility:visible]"><div data-test-render-count="1"><div class="group" style="height: auto; opacity: 1; transform: none;"><div class="contents"><div data-is-streaming="false" class="group relative relative pb-3" style="opacity: 1; transform: none;"><h2 data-find-omitted="" class="sr-only select-none">Claude a répondu : Très bien.</h2><div class="font-claude-response relative leading-[1.65rem] [&amp;_pre&gt;div]:bg-bg-000/50 [&amp;_pre&gt;div]:border-0.5 [&amp;_pre&gt;div]:border-border-400 [&amp;_.ignore-pre-bg&gt;div]:bg-transparent [&amp;_.standard-markdown_:is(p,blockquote,h1,h2,h3,h4,h5,h6)]:pl-2 [&amp;_.standard-markdown_:is(p,blockquote,ul,ol,h1,h2,h3,h4,h5,h6)]:pr-8 [&amp;_.progressive-markdown_:is(p,blockquote,h1,h2,h3,h4,h5,h6)]:pl-2 [&amp;_.progressive-markdown_:is(p,blockquote,ul,ol,h1,h2,h3,h4,h5,h6)]:pr-8"><div><div class="standard-markdown grid-cols-1 grid [&amp;_&gt;_*]:min-w-0 gap-3 standard-markdown"><p class="font-claude-response-body break-words whitespace-normal">Très bien. La page Introduction est plus dense — c'est là que tu déroules tout le parcours BUT1 → BUT2 → BUT3 avec les SAE et les stages. Je vais viser environ 4-5 minutes ici, en gardant un bon rythme (sinon le jury décroche si tu énumères trop).</p>
<p class="font-claude-response-body break-words whitespace-normal">Quelques choix de structure avant de rédiger :</p>
<ul class="[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3">
<li class="font-claude-response-body whitespace-normal break-words pl-2">Pour chaque année (BUT1, BUT2, BUT3), je propose : une phrase de transition/contexte → les SAE clés (pas toutes en détail, on cite et on garde une ou deux anecdotes) → le stage/alternance de l'année.</li>
<li class="font-claude-response-body whitespace-normal break-words pl-2">Je m'appuie sur le contenu réel de ta page (SAE Maison Rivet, GEA'Jouets, AdduXi ; Banque de France, Création d'entreprise Lyon, Griffon d'Or, Motelec ; SCIADO, IPAJE, Tecmaplast).</li>
<li class="font-claude-response-body whitespace-normal break-words pl-2">Je termine sur la phrase de synthèse de ta page : "Des cas réels, des compétences prouvées" et le lien vers les 5 compétences, pour faire la transition naturelle vers la suite de l'oral.</li>
</ul>
<p class="font-claude-response-body break-words whitespace-normal">Voici une proposition :</p>
<hr class="border-border-200 border-t-0.5 my-3 mx-1.5">
<p class="font-claude-response-body break-words whitespace-normal"><strong>📖 INTRODUCTION — environ 4-5 min</strong></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>« Mon parcours s'est construit en trois temps, que je vais vous présenter rapidement avant d'entrer dans le détail des compétences.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><strong>BUT 1 — 2023-2024 : découverte et fondamentaux</strong></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>Cette première année a été celle de ma première immersion dans le monde professionnel. J'ai découvert les notions comptables et de gestion à travers plusieurs SAE : une étude de l'environnement et de la performance financière de la Boucherie-Charcuterie La Maison Rivet à Ambérieu, et un projet tutoré, GEA'Jouets, où nous avons organisé une collecte de jouets en partenariat avec la Croix-Rouge, Radio Scoop, Century 21 et Keolis Bourg-en-Bresse.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>En parallèle, j'ai effectué mon stage chez AdduXi, où j'ai eu ma première vraie immersion comptable : DEB, TVA, lettrage, gestion des clients et fournisseurs.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><strong>BUT 2 — 2024-2025 : montée en compétences</strong></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>La deuxième année a marqué une autonomie croissante, avec des missions comptables plus approfondies. J'ai notamment réalisé un diagnostic financier complet pour la SAE Banque de France, dans le but de convaincre la banque d'accorder un prêt ; un plan stratégique et financier pour une SAE de création d'entreprise à Lyon ; et une étude de marché pour l'Hôtel Griffon d'Or.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>J'ai effectué mon stage chez Motelec Industrie, au sein du Groupe SOGAP, où j'ai géré la comptabilité de plusieurs filiales — Motelec, Billet Fournier, FIT, Firem, TSM — ce qui m'a fait gagner en autonomie sur des structures multi-entités.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><strong>BUT 3 — 2025-2026 : expertise et vision stratégique</strong></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>Cette dernière année est celle de la vision globale et de l'autonomie totale. J'ai participé à deux business games — SCIADO, sur la reprise d'un commerce de chaussures, et IPAJE, sur le développement d'une entreprise de chaussures appelée Choose — qui m'ont demandé des choix stratégiques avec une vision long terme.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>Et surtout, j'ai réalisé mon alternance chez Tecmaplast, où je gère en totale autonomie la trésorerie, les clôtures comptables, la fin d'exercice, les notes de frais, la DEB et la TVA.</em></p>
<p class="font-claude-response-body break-words whitespace-normal"><em>Trois ans, une seule trajectoire — avec des cas réels, sur des comptes d'entreprises comme Total Energies, Novartis, Géant Casino, Carrefour, Cogeci ou BNP Paribas. Ce parcours m'a permis de construire, une à une, les cinq compétences du référentiel BUT GEA, que je vais maintenant vous présenter en détail. »</em></p>
<hr class="border-border-200 border-t-0.5 my-3 mx-1.5">
<p class="font-claude-response-body break-words whitespace-normal">C'est assez long à l'oral (proche de 5 min), donc dis-moi : tu veux qu'on raccourcisse certains passages (par exemple n'évoquer qu'une SAE par année au lieu de toutes), ou ce niveau de détail te convient pour les 20 minutes ?</p></div></div></div></div></div><div class="flex justify-start opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 pointer-coarse:opacity-100 transition" role="group" aria-label="Message actions"><div class="text-text-300"><div class="text-text-300 flex items-stretch justify-between"><button type="button" data-cds="Button" class="cds-reset group/btn relative isolate inline-flex shrink-0 items-center justify-center gap-1.5 whitespace-nowrap select-none cursor-[var(--cds-cursor-interactive)] aria-disabled:cursor-default data-[disabled]:cursor-default border-0 outline-none rounded h-control font-sans text-body font-medium [&amp;:disabled:not([aria-busy])]:opacity-50 disabled:pointer-events-none transition-shadow duration-fast focus-visible:shadow-focus text-primary aria-pressed:text-accent aspect-square w-control px-0 !text-muted hover:!text-primary" aria-label="Copier" data-testid="action-bar-copy" id="base-ui-_r_70a_"><span aria-hidden="true" class="absolute -z-[1] rounded-[inherit] transition-colors duration-fast group-focus-visible/btn:shadow-[inset_0_0_0_1px_var(--cds-page-bg)] bg-transparent group-hover/btn:bg-fill-ghost-hover group-aria-expanded/btn:bg-fill-ghost-hover inset-0 group-aria-pressed/btn:bg-accent group-hover/btn:group-aria-pressed/btn:bg-accent cds-btn-squish "></span><span class="inline-flex items-center gap-1 "><span class="relative"><span data-cds="Icon" class="transition-all opacity-100 scale-100" aria-hidden="true" style="font-family: var(--font-anthropicons, Anthropicons-Variable); font-feature-settings: &quot;liga&quot; 0; font-optical-sizing: auto; font-style: normal; font-variation-settings: normal; line-height: 1; width: 1em; height: 1em;